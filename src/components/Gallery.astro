---
const photos = Array.from({ length: 25 }, (_, i) => {
  const n = String(i + 1).padStart(2, "0");
  return {
    thumb: `/images/gallery/thumb/gallery-${n}.avif`,
    full: `/images/gallery/full/gallery-${n}.avif`,
    alt: `New Bedford Oktoberfest — moment ${i + 1}`,
  };
});
---
<section class="gallery section-pad" id="gallery">
  <div class="wrap">
    <p class="eyebrow">From the Crowd</p>
    <h2>Moments From Past Oktoberfests</h2>
    <p class="gallery-lede">
      Steins raised, bands loud, Southcoast out in full force. A few shots
      from years past — click any photo for a closer look.
    </p>

    <div class="gallery-grid">
      {photos.map((p, i) => (
        <button
          type="button"
          class="gallery-item"
          data-full={p.full}
          data-alt={p.alt}
          data-index={i}
        >
          <img src={p.thumb} alt={p.alt} loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  </div>

  <div class="lightbox" id="lightbox" hidden>
    <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close photo viewer">&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous photo">&#8249;</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next photo">&#8250;</button>
  </div>
</section>

<style>
  .gallery-lede {
    max-width: 62ch;
    color: var(--text-muted);
    margin-top: 12px;
  }

  .gallery-grid {
    margin-top: 48px;
    columns: 3;
    column-gap: 16px;
  }

  .gallery-item {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0 0 16px;
    border: none;
    background: none;
    cursor: zoom-in;
    break-inside: avoid;
    border-radius: var(--radius);
    overflow: hidden;
    line-height: 0;
  }
  .gallery-item img {
    width: 100%;
    height: auto;
    transition: transform 0.35s ease;
  }
  .gallery-item:hover img,
  .gallery-item:focus-visible img {
    transform: scale(1.04);
  }

  @media (max-width: 980px) {
    .gallery-grid { columns: 2; }
  }
  @media (max-width: 560px) {
    .gallery-grid { columns: 1; }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(17, 20, 34, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }
  .lightbox[hidden] { display: none; }

  .lightbox-img {
    max-width: 100%;
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: var(--radius);
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    background: transparent;
    border: none;
    color: var(--parchment);
    cursor: pointer;
    line-height: 1;
  }
  .lightbox-close {
    top: 20px;
    right: 24px;
    font-size: 2.4rem;
    padding: 4px 10px;
  }
  .lightbox-close:hover,
  .lightbox-nav:hover { color: var(--sun-bright); }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem;
    padding: 10px 18px;
  }
  .lightbox-prev { left: 4px; }
  .lightbox-next { right: 4px; }

  @media (max-width: 640px) {
    .lightbox { padding: 16px; }
    .lightbox-nav { font-size: 2.2rem; padding: 8px 12px; }
    .lightbox-close { top: 8px; right: 12px; font-size: 2rem; }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-item"));
  const lightbox = document.getElementById("lightbox") as HTMLDivElement;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const closeBtn = document.getElementById("lightbox-close") as HTMLButtonElement;
  const prevBtn = document.getElementById("lightbox-prev") as HTMLButtonElement;
  const nextBtn = document.getElementById("lightbox-next") as HTMLButtonElement;

  let currentIndex = 0;

  function show(index: number) {
    currentIndex = (index + items.length) % items.length;
    const item = items[currentIndex];
    lightboxImg.src = item.dataset.full ?? "";
    lightboxImg.alt = item.dataset.alt ?? "";
    lightbox.hidden = false;
    document.body.style.overflow = "hidden";
  }

  function hide() {
    lightbox.hidden = true;
    lightboxImg.src = "";
    document.body.style.overflow = "";
  }

  items.forEach((item) => {
    item.addEventListener("click", () => show(Number(item.dataset.index)));
  });

  closeBtn.addEventListener("click", hide);
  prevBtn.addEventListener("click", () => show(currentIndex - 1));
  nextBtn.addEventListener("click", () => show(currentIndex + 1));

  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) hide();
  });

  document.addEventListener("keydown", (e) => {
    if (lightbox.hidden) return;
    if (e.key === "Escape") hide();
    if (e.key === "ArrowLeft") show(currentIndex - 1);
    if (e.key === "ArrowRight") show(currentIndex + 1);
  });
</script>
