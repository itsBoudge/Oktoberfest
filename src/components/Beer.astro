---
const stations = [
  {
    number: "1",
    pours: ["Coors Light", "Miller Lite", "Whaler's APA", "Guinness Stout"],
  },
  {
    number: "2",
    pours: ["Surfside Tea", "Surfside Lemonade", "Super Lyte", "Viva", "High Noon*"],
  },
  {
    number: "3",
    pours: ["Shipyard Pumpkinhead", "Paulaner Oktoberfest", "Moby Dick Oktoberfest", "Woodchuck Amber Cider"],
  },
  {
    number: "4",
    pours: ["Greater Good Pulp Daddy IPA", "Shovel Town IPA", "Devil's Purse Kolsch", "Coors Non-Alcoholic"],
  },
];
---
<section class="beer section-pad" id="beer">
  <div class="wrap">
    <p class="eyebrow">Pours &amp; Pints</p>
    <h2>What's On Tap</h2>
    <p class="beer-lede">
      Four stations, each pouring a different lineup. Every beer, cider, and
      seltzer is one ticket — find the station with what you want and start
      working through the list.
    </p>

    <div class="station-grid">
      {stations.map((s) => (
        <div class="station-card">
          <div class="station-head">
            <span class="station-number">{s.number}</span>
            <span class="station-label">Station {s.number}</span>
          </div>
          <ul class="pour-list">
            {s.pours.map((pour) => <li>{pour}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <p class="beer-note">All beers, ciders &amp; seltzers — 1 ticket. *Subject to change.</p>
  </div>
</section>

<style>
  .beer-lede {
    max-width: 62ch;
    color: var(--text-muted);
    margin-top: 12px;
  }

  .station-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 48px;
  }

  .station-card {
    background: var(--bg-panel);
    border: 1.5px solid var(--barrel);
    border-radius: var(--radius);
    padding: 26px 24px;
  }

  .station-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px dashed var(--line);
  }

  .station-number {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--parchment);
    background: var(--barrel);
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .station-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .pour-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pour-list li {
    font-size: 0.94rem;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--line);
  }
  .pour-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .beer-note {
    margin-top: 32px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 980px) {
    .station-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .station-grid { grid-template-columns: 1fr; }
  }
</style>
