---
const supportActs = ["DJ Mikey Life", "Dog on the Roof", "Off Kilter", "Real Weird", "Morrissey Blvd"];
const headliner = "Quinn Sullivan";

const schedule = [
  { time: "Until 3:30 PM", act: "House Radio", type: "Pre-show" },
  { time: "3:30 – 4:00 PM", act: "DJ Mikey Life", type: "DJ Set" },
  { time: "4:00 – 4:45 PM", act: "Dog on the Roof", type: "Youth Band" },
  { time: "4:45 – 5:00 PM", act: "Check Presentation", type: "Changeover", minor: true },
  { time: "5:00 – 6:30 PM", act: "Off Kilter", type: "Band" },
  { time: "6:30 – 6:45 PM", act: "Check Presentation", type: "Changeover", minor: true },
  { time: "6:45 – 8:15 PM", act: "Real Weird", type: "Band" },
  { time: "8:15 – 8:30 PM", act: "Check Presentation", type: "Changeover", minor: true },
  { time: "8:30 – 10:00 PM", act: "Morrissey Blvd", type: "Band" },
  { time: "10:00 – 10:15 PM", act: "Check Presentation", type: "Changeover", minor: true },
  { time: "10:15 – 11:45 PM", act: "Quinn Sullivan", type: "Headliner", headliner: true },
];
---
<section class="bands section-pad" id="lineup">
  <div class="bands-bg" style="background-image: url('/images/bands/bands-bg.jpg');"></div>
  <div class="bands-scrim"></div>
  <div class="wrap bands-grid">
    <div class="bands-content">
      <p class="eyebrow eyebrow-light">Live On the Main Stage</p>
      <h2>This Year's Lineup</h2>

      <div class="headliner">
        <span class="headliner-label">Headliner</span>
        <span class="headliner-name">{headliner}</span>
      </div>

      <div class="support-acts">
        {supportActs.map((band) => <span class="support-act">{band}</span>)}
      </div>

      <p class="bands-note">Lineup subject to updates as we lock in set times.</p>
    </div>

    <div class="bands-art">
      <img
        src="/images/bands/quinn-sullivan.webp"
        alt="Quinn Sullivan illustrated portrait playing guitar"
      />
    </div>
  </div>

  <div class="wrap schedule">
    <p class="schedule-label">Set Times</p>
    <div class="schedule-list">
      {schedule.map((s) => (
        <div class:list={["schedule-row", { minor: s.minor, headliner: s.headliner }]}>
          <span class="schedule-time">{s.time}</span>
          <span class="schedule-act">{s.act}</span>
          <span class="schedule-type">{s.type}</span>
        </div>
      ))}
    </div>
    <p class="bands-note">Times subject to change.</p>
  </div>
</section>

<style>
  .bands {
    position: relative;
    overflow: hidden;
    color: var(--parchment);
  }
  .bands-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
  }
  .bands-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(17,20,34,0.88) 0%, rgba(17,20,34,0.82) 60%, rgba(17,20,34,0.92) 100%);
  }
  .bands-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }
  .bands-content {
    text-align: left;
  }
  .bands h2 { color: var(--parchment); }
  .eyebrow-light { color: var(--sun-bright); }

  .headliner {
    margin: 36px 0 30px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .headliner-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sun-bright);
  }
  .headliner-name {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    color: var(--parchment);
  }

  .support-acts {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 14px;
  }
  .support-act {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    padding: 10px 20px;
    border: 1px solid rgba(236,225,205,0.35);
    border-radius: 999px;
    color: var(--parchment);
  }

  .bands-note {
    margin-top: 30px;
    font-size: 0.8rem;
    color: rgba(236,225,205,0.6);
  }

  .bands-art {
    display: flex;
    justify-content: center;
  }
  .bands-art img {
    width: 100%;
    max-width: 420px;
    height: auto;
  }

  @media (max-width: 860px) {
    .bands-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .bands-content { text-align: center; }
    .support-acts { justify-content: center; }
    .bands-art { order: -1; }
    .bands-art img { max-width: 280px; }
  }

  .schedule {
    position: relative;
    z-index: 2;
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid rgba(236,225,205,0.18);
  }
  .schedule-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sun-bright);
    margin-bottom: 18px;
  }
  .schedule-list {
    display: flex;
    flex-direction: column;
  }
  .schedule-row {
    display: grid;
    grid-template-columns: 0.9fr 1.3fr 0.8fr;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px dashed rgba(236,225,205,0.16);
  }
  .schedule-row:last-child { border-bottom: none; }
  .schedule-time {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: rgba(236,225,205,0.6);
  }
  .schedule-act {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--parchment);
  }
  .schedule-type {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(236,225,205,0.5);
    text-align: right;
  }
  .schedule-row.minor .schedule-act,
  .schedule-row.minor .schedule-time {
    color: rgba(236,225,205,0.4);
    font-size: 0.82rem;
    font-family: var(--font-mono);
  }
  .schedule-row.headliner .schedule-act {
    color: var(--sun-bright);
  }
  .schedule-row.headliner .schedule-type {
    color: var(--sun-bright);
  }

  @media (max-width: 640px) {
    .schedule-row {
      grid-template-columns: 1fr;
      gap: 4px;
      text-align: left;
    }
    .schedule-type { text-align: left; }
  }
</style>
